
GOOGLE_API_KEY=
DATABASE_URL=""

# Cloudflare R2 credentials are server-side only; never commit real values.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rca-jira-dataset
R2_REGION=auto
GEMINI_MODEL=gemini-3.6-flash
ENVIRONMENT=development
API_AUTH_REQUIRED=false
API_AUTH_TOKEN=
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_DATASET_KEY=jira/2025-06-23 ThePublicJiraDataset.zip
R2_MANIFEST_KEY=dataset-manifest.json
R2_CATALOG_KEY=incident-catalog.json
R2_BATCH_CATALOG_KEY=incidents/catalog.json
R2_BATCH_PREFIX=incidents/
R2_CATALOG_MAX_BYTES=16777216
R2_EXPANSION_ENABLED=true
R2_MAX_CANDIDATES=10
RCA_STRONG_THRESHOLD=0.82
RCA_MEDIUM_THRESHOLD=0.65
RCA_WEAK_THRESHOLD=0.35
