# Database
DATABASE_URL=your-database-url

# LLM Config
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# RAG & Retrieval Config
DEFAULT_TOP_K=5
MIN_SIMILARITY_SCORE=0.35
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Ingestion
INGEST_BATCH_SIZE=100
INGEST_MAX_RECORDS=1000

# External Integration Config (Zenodo)
ZENODO_ACCESS_TOKEN=your-zenodo-access-token
ZENODO_RECORD_URL=https://zenodo.org/records/7740379
ZENODO_RECORD_ID=7740379
ZENODO_SOURCE_NAME="Apache Jira Issue Tracking Dataset"
ZENODO_API_URL=https://zenodo.org/api
ZENODO_CACHE_TTL=3600
ZENODO_REQUEST_TIMEOUT=30.0
ZENODO_SAMPLE_SIZE=5

# Data Config
JIRA_DATA_DIR=C:/external/jira-data
